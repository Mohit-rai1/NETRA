# ==============================================================================
# Project NETRA — CV Engine Environment Variables
# Copy this file to ".env" and adjust values for your environment.
# ==============================================================================

# Server
DEBUG=false

# Upload limits
MAX_UPLOAD_SIZE_MB=10.0

# Enhancement pipeline toggles
GRAY_WORLD_ENABLED=true
CLAHE_ENABLED=true
CLAHE_CLIP_LIMIT=2.0
CLAHE_TILE_GRID_SIZE=8

# Output encoding
OUTPUT_FORMAT=JPEG
JPEG_QUALITY=92

# Java backend URL (for CORS allow-list)
JAVA_BACKEND_URL=http://localhost:8080
